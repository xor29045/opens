---
import Public from '../../layouts/Public.astro';
import EstablishmentView from '../../features/catalog/EstablishmentView.tsx';

// Reserved to signed-in users (middleware guard).
const { slug } = Astro.params;
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
Astro.response.headers.set('X-Robots-Tag', 'noindex');
---
<Public title="Établissement" description="Maison partenaire et ses professionnel·les.">
  <EstablishmentView slug={slug ?? ''} client:only="react" />
</Public>
