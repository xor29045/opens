---
import Public from '../../layouts/Public.astro';
import ProfileView from '../../features/catalog/ProfileView.tsx';

// Public (ADR-023); the profile is loaded in the browser so a staff session
// is still sent. The page is not indexed.
const { slug } = Astro.params;
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
Astro.response.headers.set('X-Robots-Tag', 'noindex');
---
<Public title="Profil" description="Profil d’une professionnel·le d’une maison partenaire.">
  <ProfileView slug={slug ?? ''} client:only="react" />
</Public>
