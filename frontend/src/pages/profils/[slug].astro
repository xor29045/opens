---
import Public from '../../layouts/Public.astro';
import { internalApiBase } from '../../lib/config';
import ProfileView from '../../features/catalog/ProfileView.tsx';
import type { components } from '../../lib/api/schema';

type PublicProfile = components['schemas']['PublicProfile'];

// Server-rendered for SEO; the interactive parts (gallery, favourite) hydrate.
const { slug } = Astro.params;
const res = await fetch(`${internalApiBase()}/profiles/${encodeURIComponent(slug ?? '')}`, {
  signal: AbortSignal.timeout(10_000),
});
if (res.status === 404) return new Response(null, { status: 404 });
if (!res.ok) return new Response(null, { status: 503 });
const profile = (await res.json()) as PublicProfile;
const title = `${profile.display_name} · ${profile.establishment.display_name}`;
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
---
<Public title={title} description={profile.headline || `Profil publié — ${profile.establishment.display_name}`}>
  <ProfileView profile={profile} client:load />
</Public>
