---
import Public from '../../layouts/Public.astro';
import ProfileView from '../../features/catalog/ProfileView.tsx';

// Reserved to signed-in users (middleware guard); the profile is loaded in
// the browser with the session, so the page is never indexed or cached.
const { slug } = Astro.params;
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
Astro.response.headers.set('X-Robots-Tag', 'noindex');
---
<Public title="Profil" description="Profil d’une professionnel·le d’une maison partenaire.">
  <ProfileView slug={slug ?? ''} client:only="react" />
</Public>
