---
// Age gate for visitors (F9, T6.2). Rendered only when the consent cookie is
// absent; the choice is remembered for one year. This is an access barrier,
// not an identity check (profiles are created by their house).
const accepted = Astro.cookies.get('os_age_ok')?.value === '1';
---
{!accepted && (
  <div class="os-agegate" id="os-agegate" role="dialog" aria-modal="true" aria-labelledby="agegate-title">
    <div class="os-agegate__panel">
      <span class="os-agegate__badge" aria-hidden="true">18+</span>
      <h2 id="agegate-title">Contenu réservé aux adultes</h2>
      <p>
        Ce site présente des professionnel·les du travail du sexe. Son accès est réservé aux personnes majeures.
      </p>
      <div class="os-agegate__actions">
        <button type="button" class="os-btn os-btn--primary" data-agegate="accept">J’ai 18 ans ou plus — entrer</button>
        <a class="os-btn os-btn--ghost" href="https://www.google.be" rel="noopener noreferrer">Quitter</a>
      </div>
      <p class="os-agegate__note">En entrant, tu confirmes être majeur·e et accepter les <a href="/legal/cgu">CGU</a>.</p>
    </div>
  </div>
)}

<script>
  const gate = document.getElementById('os-agegate');
  if (gate) {
    document.documentElement.style.overflow = 'hidden';
    gate.querySelector<HTMLButtonElement>('[data-agegate="accept"]')?.focus();
    gate.querySelector('[data-agegate="accept"]')?.addEventListener('click', () => {
      const secure = location.protocol === 'https:' ? '; Secure' : '';
      document.cookie = `os_age_ok=1; Max-Age=31536000; Path=/; SameSite=Lax${secure}`;
      gate.hidden = true;
      document.documentElement.style.overflow = '';
    });
  }
</script>
