# ---------------------------------------------------------------------------
# Configuration — every variable of §15.3. Copy to .env for docker compose
# (dev). In staging/production use secret files (<VAR>_FILE) instead of
# plain values. Generate keys with: openssl rand -base64 32
# ---------------------------------------------------------------------------

# --- Application
APP_ENV=development                 # development | staging | production
APP_BASE_URL=https://localhost      # public URL (frontend + /api), https outside dev
API_PORT=8080
LOG_LEVEL=info                      # debug | info | warn | error
LOG_FORMAT=json                     # json | text (text default in dev)
SWAGGER_ENABLED=false               # refused in production
TERMS_VERSION=2026-11-02            # version of CGU/CGV/DPA accepted at registration
OPENAPI_SPEC_FILE=../api/openapi.yaml
HTTPS_PORT=443                      # docker compose dev: host port of Caddy

# --- PostgreSQL (docker compose dev)
POSTGRES_PASSWORD=change-me-postgres
APP_DB_NAME=opensex
APP_MIGRATOR_PASSWORD=change-me-migrator
APP_RW_PASSWORD=change-me-rw
APP_RO_PASSWORD=change-me-ro
# Used by the API and the worker (role app_rw); ops migrate uses app_migrator.
DATABASE_URL=postgres://app_rw:change-me-rw@localhost:5432/opensex?sslmode=disable
DB_MAX_CONNS=20

# --- Redis (rate limiting, denylist, stats)
REDIS_URL=redis://localhost:6379/0

# --- JWT (EdDSA). Keys: <kid>.pem (private) / <kid>.pub.pem (verification only)
JWT_ISSUER=https://localhost/api
JWT_AUDIENCE=localhost-api
JWT_KEYS_DIR=./tmp/jwt
JWT_ACTIVE_KID=dev-1               # a kid starting with "dev" is refused in production
ACCESS_TOKEN_TTL=10m
ADMIN_ACCESS_TOKEN_TTL=5m
REFRESH_TOKEN_TTL=168h
REFRESH_TOKEN_ABSOLUTE_TTL=720h
ADMIN_REFRESH_TOKEN_TTL=8h
ADMIN_REFRESH_TOKEN_ABSOLUTE_TTL=12h
COOKIE_SECURE=true                  # __Host-rt cookie; must be true outside dev

# --- Passwords (Argon2id, §12.6)
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=2
ARGON2_MAX_CONCURRENT=8
HIBP_ENABLED=false                  # true by default outside dev

# --- Keys (base64 or hex, ≥ 32 bytes, distinct)
FIELD_ENCRYPTION_KEYS=v1:REPLACE_WITH_BASE64_32_BYTES_KEY_000000000=
IP_HASH_KEY=REPLACE_WITH_BASE64_32_BYTES_KEY_1111111111=
RECOVERY_CODE_HMAC_KEY=REPLACE_WITH_BASE64_32_BYTES_KEY_222222222=

# --- HTTP
CORS_ALLOWED_ORIGINS=https://localhost   # exact origins, comma separated, never * outside dev
TRUSTED_PROXIES=                         # CIDRs of the reverse proxies (X-Forwarded-For)

# --- Payments (NOWPayments)
PAYMENT_PROVIDER=fake                    # nowpayments | fake (dev only)
NOWPAYMENTS_API_URL=https://api-sandbox.nowpayments.io/v1
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_IPN_CALLBACK_URL=https://localhost/api/v1/webhooks/nowpayments
PAYMENT_UNDERPAY_TOLERANCE_BPS=100       # 1 %

# --- Photo storage (S3 compatible)
STORAGE_DRIVER=s3                        # s3 | memory (dev only)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=photos
S3_ACCESS_KEY=minio-dev
S3_SECRET_KEY=change-me-minio
S3_REGION=eu-west-1
S3_PUBLIC_ENDPOINT=                      # endpoint used in signed URLs (browser side); default S3_ENDPOINT
PHOTOS_PUBLIC_BASE_URL=                  # CDN prefix; empty = signed URLs
MINIO_ROOT_USER=minio-dev
MINIO_ROOT_PASSWORD=change-me-minio

# --- Platform publisher (legal notices, invoices)
PLATFORM_LEGAL_NAME="Éditeur SRL"
PLATFORM_COMPANY_NUMBER=0403.170.701
PLATFORM_ADDRESS="Rue Exemple 1, 1000 Bruxelles"

# --- Admin bootstrap (RM-02b)
ADMIN_BOOTSTRAP_USERNAME=root_admin
ADMIN_BOOTSTRAP_PASSWORD=change-me-at-least-16-chars   # development only
ADMIN_BOOTSTRAP_PASSWORD_FILE=                         # mandatory outside dev
ADMIN_BOOTSTRAP_USERS_FILE=                            # JSON [{"username":"…","password_file":"…"}]
ADMIN_ALLOWED_CIDRS=                                   # recommended in production
ADMIN_ALERT_WEBHOOK_URL=

# --- Frontend
PUBLIC_API_BASE_URL=https://localhost/api/v1
